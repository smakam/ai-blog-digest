{"type": "item", "run_id": "20261101T014726Z-routine", "option": "routine", "item_id": "48221db7043e718ea80185e4", "title": "Agents Prompt People: Using Agents for Long-Horizon Financial Work", "url": "https://latent.space/p/arca/", "source": "Latent Space", "published": "2026-10-31T16:05:00+00:00", "is_ai": 0.98, "worthiness": 0.7275, "worthiness_confidence": 0.9, "final_score": 0.7275, "bucket": "high", "full_text": true, "content_source": "feed_full_text", "text_chars": 4280, "delivered": true, "summary": "Arca, an AI-native wealth management firm, uses agents for long-horizon financial tasks while keeping humans in control of final decisions. Agents handle analysis and proposals across multi-day workflows with persistent memory systems tracking client state, but trading and money movement require human approval. The company built a custom model harness using Claude as primary provider with automatic task-based model selection, implements deterministic safety restrictions and sandboxed code execution for data access, and uses meta-agents analyzing advisor feedback to continuously improve the system. For AI engineers building financial systems, the key insight is that agent infrastructure ownership enables safety through deterministic guardrails and flexible model switching rather than relying on managed platforms.", "jev_ms": 425.6, "jev_input_tokens": 1575, "jev_cost": 6.615e-05, "llm_ms": 3463.9, "llm_cost": 0.00192, "errors": []}
