{"type": "item", "run_id": "20261001T014638Z-routine", "option": "routine", "item_id": "2efebb52e52f8375b5e6c72d", "title": "Deploying an HSTU Generative Recommender with NVIDIA Dynamo-Triton", "url": "https://developer.nvidia.com/blog/deploying-an-hstu-generative-recommender-with-nvidia-dynamo-triton/", "source": "NVIDIA Technical Blog", "published": "2026-09-30T20:54:59+00:00", "is_ai": 0.99, "worthiness": 0.7675, "worthiness_confidence": 0.93, "final_score": 0.7675, "bucket": "high", "full_text": true, "content_source": "article_fetch", "text_chars": 12548, "delivered": true, "summary": "NVIDIA Dynamo-Triton now supports end-to-end inference for Hierarchical Sequential Transduction Unit (HSTU) generative recommenders, combining PyTorch Ahead-of-Time compilation, FlexKV-backed KV caching, and GPU embedding caches. This matters because serving long-sequence recommendation models requires low-latency inference despite large histories and embedding tables. The workflow achieves up to 5.93x latency speedup on eight-layer HSTU models with GPU KV-cache hits on RTX PRO 6000 Blackwell, reaching 0.678ms per request at batch size 8. Key takeaway: KV caching reuses previously computed attention state for unchanged user history prefixes, eliminating redundant computation across multiple HSTU layers.", "jev_ms": 216.1, "jev_input_tokens": 3191, "jev_cost": 0.000134022, "llm_ms": 5213.4, "llm_cost": 0.003928, "errors": []}
