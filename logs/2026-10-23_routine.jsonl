{"type": "item", "run_id": "20261023T014653Z-routine", "option": "routine", "item_id": "e60d9e12febedcf975b38c36", "title": "Running Frontier-Class AI Models Across 8 NVIDIA DGX Spark Nodes", "url": "https://developer.nvidia.com/blog/running-frontier-class-ai-models-across-8-nvidia-dgx-spark-nodes/", "source": "NVIDIA Technical Blog", "published": "2026-10-22T16:00:00+00:00", "is_ai": 0.99, "worthiness": 0.7925, "worthiness_confidence": 0.86, "final_score": 0.7925, "bucket": "high", "full_text": true, "content_source": "article_fetch", "text_chars": 9953, "delivered": true, "summary": "NVIDIA announced official support for eight-node DGX Spark clusters, scaling unified memory to 1 TB and enabling frontier-class models like GLM 5.3 (753B) to run locally at 80 tokens per second. The cluster achieves near-linear training scaling (7.79x speedup on 8 nodes) and supports multi-model orchestration via NeMo Switchyard, routing requests between models to increase aggregate throughput by up to 3x. A new Spark-optimized collective backend (RoCEnante) improves decode throughput by 21% at four nodes through direct peer-to-peer communication, though it trades bandwidth efficiency for latency gains. Developers can choose switchless ring topologies for cost-effective four-node setups or switch-connected clusters for eight-node scaling and flexible workload splitting.", "jev_ms": 156.4, "jev_input_tokens": 3044, "jev_cost": 0.000127848, "llm_ms": 4098.9, "llm_cost": 0.003757, "errors": []}
