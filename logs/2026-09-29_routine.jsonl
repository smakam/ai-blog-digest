{"type": "item", "run_id": "20260929T014630Z-routine", "option": "routine", "item_id": "b7d482ff6a323e5577dbc620", "title": "Credentials API for Gemini Managed Agents", "url": "https://www.philschmid.de/managed-agents-credentials", "source": "philschmid.de - RSS feed", "published": "2026-09-28T00:00:00+00:00", "is_ai": 0.96, "worthiness": 0.745, "worthiness_confidence": 0.98, "final_score": 0.745, "bucket": "high", "full_text": true, "content_source": "article_fetch", "text_chars": 3352, "delivered": true, "summary": "Google shipped a Credentials API for Gemini Managed Agents that securely injects secrets into agent calls without exposing them in the sandbox. Instead of storing API keys as environment variables (where untrusted code can leak them), credentials are registered once, encrypted at rest, and injected by an egress proxy only when making requests to trusted domains. The API supports bearer tokens, OAuth2 refresh tokens, and environment variables, with domain-level restrictions preventing credential misuse. For builders, this eliminates the security risk of secrets in sandboxed environments while enabling seamless authentication to external services like GitHub and the Gemini API.", "jev_ms": 457.8, "jev_input_tokens": 1373, "jev_cost": 5.7666e-05, "llm_ms": 2813.3, "llm_cost": 0.001708, "errors": []}
