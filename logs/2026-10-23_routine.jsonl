{"type": "item", "run_id": "20261023T014653Z-routine", "option": "routine", "item_id": "6ff8827a77533428cc37bacd", "title": "Building agents: When to fold subagents into your main agent loop", "url": "https://claude.com/resources/articles/building-agents-when-to-fold-subagents-into-your-main-agent-loop", "source": "Claude Blog", "published": "2026-10-22T00:00:00+00:00", "is_ai": 0.99, "worthiness": 0.8, "worthiness_confidence": 0.83, "final_score": 0.8, "bucket": "high", "full_text": true, "content_source": "article_fetch", "text_chars": 17263, "delivered": true, "summary": "Anthropic's Applied AI team recommends consolidating multi-agent systems into single agent loops with progressively disclosed skills and tools rather than separate subagents. This approach improves quality while reducing latency and cost—one customer saw 2x faster runtime. The key insight: modern models like Opus 4.5+ handle complex reasoning in one context window better than orchestrator-subagent architectures, which suffer from context loss and latency. Start by building task-completion evals, then fold subagents into skills and MCP tools one at a time, measuring performance changes before committing to each migration step.", "jev_ms": 216.3, "jev_input_tokens": 4134, "jev_cost": 0.000173628, "llm_ms": 3098.8, "llm_cost": 0.004596, "errors": []}
