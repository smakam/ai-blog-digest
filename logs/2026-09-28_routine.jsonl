{"type": "item", "run_id": "20260928T014558Z-routine", "option": "routine", "item_id": "55fee9238304d3bf8605ed89", "title": "How NVIDIA DSX MaxLPS Maximizes AI Factory Throughput and Efficiency", "url": "https://developer.nvidia.com/blog/how-nvidia-dsx-maxlps-maximizes-ai-factory-throughput-and-efficiency/", "source": "NVIDIA Technical Blog", "published": "2026-09-28T01:00:00+00:00", "is_ai": 0.95, "worthiness": 0.8675, "worthiness_confidence": 0.59, "final_score": 0.8675, "bucket": "high", "full_text": true, "content_source": "article_fetch", "text_chars": 11122, "delivered": true, "summary": "NVIDIA DSX MaxLPS dynamically reallocates power across GPUs within a fixed facility budget, enabling 37% more GPUs (140 to 192) while maintaining per-instance throughput. The system uses policy-governed power sharing to exploit workload variability—training and inference naturally draw variable power—recapturing stranded capacity. In Nscale's evaluation with Kimi K2.5 on GB300 NVL72 systems, throughput per provisioned watt improved 49.2% to 6.12 tokens/s/W, though P99 latency increased 17%. Key takeaway: validate representative production workloads against aggregate limits before deployment, as tail latency and telemetry reliability directly impact service quality.", "jev_ms": 621.3, "jev_input_tokens": 2929, "jev_cost": 0.000123018, "llm_ms": 4319.5, "llm_cost": 0.003505, "errors": []}
