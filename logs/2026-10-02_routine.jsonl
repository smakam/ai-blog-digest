{"type": "item", "run_id": "20261002T014554Z-routine", "option": "routine", "item_id": "e48a7f736f56ad596c7cd7f9", "title": "Quoting Matthew Green", "url": "https://simonwillison.net/2026/Oct/1/matthew-green/", "source": "Simon Willison's Weblog", "published": "2026-10-01T06:29:01+00:00", "is_ai": 0.98, "worthiness": 0.54, "worthiness_confidence": 0.6, "final_score": 0.54, "bucket": "medium", "full_text": false, "content_source": "title_summary", "text_chars": 893, "delivered": true, "summary": null, "jev_ms": 509.1, "jev_input_tokens": 839, "jev_cost": 3.5238e-05, "llm_ms": null, "llm_cost": null, "errors": []}
{"type": "item", "run_id": "20261002T014554Z-routine", "option": "routine", "item_id": "da0034913ac66df228385b13", "title": "Academia is for Ambition — Alex Zhang, MIT", "url": "https://www.latent.space/p/rlm", "source": "Latent.Space", "published": "2026-10-02T00:28:04+00:00", "is_ai": 0.99, "worthiness": 0.84, "worthiness_confidence": 0.59, "final_score": 0.84, "bucket": "high", "full_text": true, "content_source": "feed_full_text", "text_chars": 127336, "delivered": true, "summary": "Alex Zhang's MIT research explores how much AI capability we're leaving on the table by wrapping powerful models in primitive systems. His work on Recursive Language Models (RLMs) and harnesses as compositional generalizers shows that models can learn to generalize across seemingly different tasks when given proper structure. Key insight: PhD students should take research bets on ideas that look trivial or pointless to industry—like RLMs initially did—because academia's advantage is freedom from bureaucratic constraints to explore unconventional directions that frontier labs won't risk.", "jev_ms": 529.4, "jev_input_tokens": 22695, "jev_cost": 0.00095319, "llm_ms": 3131.3, "llm_cost": 0.016819, "errors": []}
