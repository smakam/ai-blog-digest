{"type": "item", "run_id": "20261020T014634Z-routine", "option": "routine", "item_id": "59dd48e60c6b9abf716e6516", "title": "Achieving near-zero-downtime scaling in Elastic Expert Parallelism", "url": "https://vllm.ai/blog/2026-10-19-elastic-ep-near-zero-downtime", "source": "vLLM Blog", "published": "2026-10-19T00:00:00+00:00", "is_ai": 0.99, "worthiness": 0.99, "worthiness_confidence": 0.97, "final_score": 0.99, "bucket": "high", "full_text": true, "content_source": "article_fetch", "text_chars": 13732, "delivered": true, "summary": "vLLM's Elastic Expert Parallelism now achieves near-zero-downtime GPU scaling using NIXL EP, a custom communication library that adds or removes ranks in-place while preserving CUDA graphs on existing workers. Scaling DeepSeek V4 Pro from 16 to 20 GB200 GPUs reduced downtime from 100 seconds to 0.82 seconds by overlapping topology preparation with serving and allowing joining workers to prepare independently without disrupting active inference. For teams running large-scale inference, this eliminates costly serving interruptions during autoscaling operations. Key takeaway: reusing existing CUDA graphs and asynchronously preparing new workers' communication and execution state enables production-grade dynamic scaling without restart penalties.", "jev_ms": 144.1, "jev_input_tokens": 3479, "jev_cost": 0.000146118, "llm_ms": 4584.1, "llm_cost": 0.00416, "errors": []}
