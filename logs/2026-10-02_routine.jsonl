{"type": "item", "run_id": "20261002T014554Z-routine", "option": "routine", "item_id": "f928531f963725197f57d3d7", "title": "Introducing Olmo-core 3: Open, scalable training infrastructure for large MoEs", "url": "https://huggingface.co/blog/allenai/olmocore3", "source": "Hugging Face - Blog", "published": "2026-10-01T15:01:43+00:00", "is_ai": 0.99, "worthiness": 0.94, "worthiness_confidence": 0.8, "final_score": 0.94, "bucket": "high", "full_text": true, "content_source": "article_fetch", "text_chars": 8521, "delivered": true, "summary": "Allen AI released Olmo-core 3, an open-source training framework for scaling mixture-of-experts models to trillion parameters while maintaining efficiency. The system switches from FSDP to distributed data parallelism, achieving 2.7× throughput improvement on 47B-parameter MoEs and demonstrating performance at 1.2 trillion parameters across 512 GPUs. Key innovations include expert parallelism, rowwise data routing, GPU-resident routing, and MXFP8 precision, which together reduced memory usage by 8% while improving throughput 21%. For builders, this open infrastructure enables efficient large-scale MoE training previously limited to well-resourced labs, with the takeaway that co-optimizing parallelism strategies, routing, and precision across the full training pipeline matters more than optimizing individual components.", "jev_ms": 545.6, "jev_input_tokens": 2386, "jev_cost": 0.000100212, "llm_ms": 4196.8, "llm_cost": 0.00303, "errors": []}
